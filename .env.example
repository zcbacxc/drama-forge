# ============================================================
# drama-forge — .env.example
#
# Infrastructure / Provider configuration (DRAMA_FORGE_*).
# Copy to:
#   - project root: .env          (gitignored, highest priority)
#   - user level:   ~/.drama-forge/.env  (auto-created on first run)
#
# Story content is NOT configured here — use story JSON / Manifest.
# ============================================================

# mock | openai_compatible | deepseek | siliconflow | agnes | agnes-image
# | production (deepseek+siliconflow) | combined: a+b
DRAMA_FORGE_PROVIDER=mock

# Force offline deterministic fallbacks (no network). 1/true/yes/on
# DRAMA_FORGE_PROVIDER_DRY_RUN=1

# Optional local paths
# DRAMA_FORGE_ARTIFACT_ROOT=.drama_forge_artifacts
# DRAMA_FORGE_DB_PATH=production.db

# Live smoke for tests (requires real keys; leave unset in CI)
# DRAMA_FORGE_LIVE_SMOKE=1

# ============================================================
# Retry backoff (Scheduler HARD retryable failures only)
# ============================================================
# Delay after first failure in seconds; 0 disables sleep (tests).
# DRAMA_FORGE_RETRY_BASE_DELAY=0.5
# DRAMA_FORGE_RETRY_FACTOR=2
# DRAMA_FORGE_RETRY_MAX_DELAY=30
# DRAMA_FORGE_RETRY_JITTER=0.1

# ============================================================
# Circuit breaker (HTTP-backed providers; state never enters fingerprints)
# Opt-in: set ENABLED=1 to wrap HTTP adapters (CLOSED/OPEN/HALF_OPEN).
# ============================================================
# DRAMA_FORGE_CIRCUIT_ENABLED=0
# DRAMA_FORGE_CIRCUIT_FAILURE_THRESHOLD=5
# DRAMA_FORGE_CIRCUIT_RECOVERY_TIMEOUT=30
# DRAMA_FORGE_CIRCUIT_HALF_OPEN_MAX_CALLS=1

# ============================================================
# Generic OpenAI-compatible HTTP (provider=openai_compatible)
# ============================================================
# DRAMA_FORGE_PROVIDER_BASE_URL=https://api.openai.com
# DRAMA_FORGE_PROVIDER_API_KEY=
# DRAMA_FORGE_PROVIDER_MODEL=gpt-4o-mini
# DRAMA_FORGE_PROVIDER_TIMEOUT=30
# DRAMA_FORGE_PROVIDER_ID=openai-compatible
# DRAMA_FORGE_PROVIDER_CHAT_PATH=v1/chat/completions

# ============================================================
# DeepSeek (OpenAI-compatible preset; provider=deepseek)
# ============================================================
# DRAMA_FORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
# DRAMA_FORGE_DEEPSEEK_API_KEY=
# DRAMA_FORGE_DEEPSEEK_MODEL=deepseek-flash
# DRAMA_FORGE_DEEPSEEK_TIMEOUT=60
# DRAMA_FORGE_DEEPSEEK_ID=deepseek
# DRAMA_FORGE_DEEPSEEK_CHAT_PATH=chat/completions

# ============================================================
# SiliconFlow image (provider=siliconflow)
# ============================================================
# DRAMA_FORGE_SILICONFLOW_BASE_URL=https://api.siliconflow.cn
# DRAMA_FORGE_SILICONFLOW_API_KEY=
# DRAMA_FORGE_SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
# DRAMA_FORGE_SILICONFLOW_IMAGE_SIZE=1024x1024
# DRAMA_FORGE_SILICONFLOW_ID=siliconflow-image

# ============================================================
# Agnes gateway — image + video (provider=agnes-image / agnes)
# ============================================================
# DRAMA_FORGE_AGNES_BASE_URL=https://your-gateway/v1
# DRAMA_FORGE_AGNES_API_KEY=
# DRAMA_FORGE_AGNES_IMAGE_MODEL=agnes-image-2.0-flash
# DRAMA_FORGE_AGNES_IMAGE_ID=agnes-image
# DRAMA_FORGE_AGNES_MODEL=agnes-video-2.5-flash
# DRAMA_FORGE_AGNES_MODE=t2v
# DRAMA_FORGE_AGNES_ID=agnes-video
# DRAMA_FORGE_AGNES_TIMEOUT=120
